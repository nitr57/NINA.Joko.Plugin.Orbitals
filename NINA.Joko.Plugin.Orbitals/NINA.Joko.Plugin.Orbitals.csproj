<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DefaultItemExcludes Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))">$(DefaultItemExcludes);**/*.xaml.cs;**/*.xaml</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Service Include="{508349B6-6B84-4DF5-91F0-309BEEBAD82D}" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ASCOM.Platform" Version="6.5.2" />
    <PackageReference Include="FlatFiles" Version="5.0.4" />
    <PackageReference Include="Mindbox.Data.Linq" Version="5.0.0" />
    <ProjectReference Include="..\..\..\NINA.Plugin\NINA.Plugin.csproj" />
    <PackageReference Include="protobuf-net" Version="3.1.26" />
    <PackageReference Include="protobuf-net.Core" Version="3.1.26" />
    <PackageReference Include="SGP.NET" Version="1.3.2" />
    <PackageReference Include="SQLite.Interop.dll" Version="1.0.103" />
    <PackageReference Include="System.Data.SQLite" Version="2.0.2" />
  </ItemGroup>
  <ItemGroup>
    <Page Remove="Properties\DesignTimeResources.xaml" />
  </ItemGroup>
  <PropertyGroup />
  <Target Name="PostBuildLinux" AfterTargets="PostBuildEvent">
    <Exec Command="mkdir -p $HOME/.local/share/NINA/Plugins/3.0.0/Orbitals" />
    <Exec Command="cp $(TargetPath) $HOME/.local/share/NINA/Plugins/3.0.0/Orbitals/" />
    <Exec Command="cp $(TargetDir)protobuf-net*.dll $HOME/.local/share/NINA/Plugins/3.0.0/Orbitals/" />
    <Exec Command="cp $(TargetDir)Trinet*.dll $HOME/.local/share/NINA/Plugins/3.0.0/Orbitals/" />
    <Exec Command="cp $(TargetDir)FlatFiles*.dll $HOME/.local/share/NINA/Plugins/3.0.0/Orbitals/" />
    <Exec Command="cp $(TargetDir)Mindbox.Data.Linq.dll $HOME/.local/share/NINA/Plugins/3.0.0/Orbitals/" />
    <Exec Command="cp $(TargetDir)SGP.NET.dll $HOME/.local/share/NINA/Plugins/3.0.0/Orbitals/" />
  </Target>
</Project>
